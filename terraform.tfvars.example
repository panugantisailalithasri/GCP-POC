# Copy to terraform.tfvars and fill in values before running terraform apply.
#   cp terraform.tfvars.example terraform.tfvars

project_id  = "freyr-ai"
bucket_name = "freyr-ai-poc-storage"
location    = "US-CENTRAL1"
region      = "us-central1"

# Keep false unless this is a disposable POC you want Terraform to empty on destroy.
force_destroy = false

soft_delete_retention_days = 7

# Optional: extra IAM matching the reference bucket's Reasoning Engine agent.
# Uncomment and adjust the prefix expression if this POC needs the same grant.
# The screenshot condition title was pac-mcp-catalog-prefix; the CEL below
# limits Object Admin to objects whose name starts with catalog/.
