#       title       = "pac-mcp-catalog-prefix"
#       description = "Limit the Reasoning Engine agent to the catalog/ object prefix"
#       expression  = "resource.name.startsWith(\"projects/_/buckets/freyr-ai-poc-storage/objects/catalog/\")"
