# GCS backend for Terraform state. Copy to backend.hcl (gitignored) and fill in.
# Create this state bucket once (do not store state in the POC resource bucket).
#
#   gcloud storage buckets create gs://freyr-ai-poc-tfstate \
#     --project=freyr-ai \
#     --location=us-central1 \
#     --uniform-bucket-level-access

bucket = "freyr-ai-poc-tfstate"
prefix = "gcp/poc-storage"
